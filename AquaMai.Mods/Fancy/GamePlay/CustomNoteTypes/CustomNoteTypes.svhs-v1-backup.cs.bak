    private static readonly Dictionary<int, float> NoteSpeedByIndex = new Dictionary<int, float>();
    private static readonly Queue<float> PendingNoteSpeedMultipliers = new Queue<float>();
    private static readonly Queue<float> PendingTouchSpeedMultipliers = new Queue<float>();
    private static NoteData _currentNoteData;
    private static int _noteCountBeforeLoad;
    private static float? _optionalSpeedForCurrentLoad;
    private static string _removedOptionalSpeedString;
    private static bool _optionalSpeedRemoved;


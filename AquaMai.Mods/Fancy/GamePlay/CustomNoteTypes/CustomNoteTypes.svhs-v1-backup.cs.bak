        // Taps
        ["NMTAP"] = 4,
        ["BRTAP"] = 4,
        ["EXTAP"] = 4,
        ["BXTAP"] = 4,
        // Holds
        ["NMHLD"] = 5,
        ["BRHLD"] = 5,
        ["EXHLD"] = 5,
        ["BXHLD"] = 5,
        // Touch
        ["NMTTP"] = 7,
        ["BRTTP"] = 7,
        ["EXTTP"] = 7,
        ["BXTTP"] = 7,
        // Stars
        ["NMSTR"] = 4,
        ["BRSTR"] = 4,
        ["EXSTR"] = 4,
        ["BXSTR"] = 4,
        // Slides seen in standard MA2 charts
        ["NMSI_"] = 7,
        ["NMSL_"] = 7,
        ["NMSR_"] = 7,
        ["NMSU_"] = 7,
        ["NMSD_"] = 7,
        ["NMSCL"] = 7,
        ["NMSCR"] = 7,
        ["NMSXL"] = 7,
        ["NMSXR"] = 7,
        ["NMSUL"] = 7,
        ["NMSUR"] = 7,
        ["NMSLL"] = 7,
        ["NMSLR"] = 7,
        ["NMSNL"] = 7,
        ["NMSNR"] = 7,
        ["NMSFL"] = 7,
        ["NMSFR"] = 7,
        ["NMSF_"] = 7,
